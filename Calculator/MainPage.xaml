<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculator.MainPage"
             BackgroundColor="#1C1C1C">

    <Grid RowDefinitions="0.3*,0.7*">
        
        <Label x:Name="Display"
               Grid.Row="0" 
               Text="0" 
               FontSize="60" 
               TextColor="White"
               HorizontalTextAlignment="End" 
               VerticalTextAlignment="Center"
               Padding="20,0"/>

        <Grid Grid.Row="1" RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*,*" 
              Padding="10" RowSpacing="10" ColumnSpacing="10">
            
            <!-- Ряд 1: Служебные кнопки -->
            <Button Grid.Row="0" Grid.Column="0" Text="C" Clicked="ButtonClear_Clicked" 
                    BackgroundColor="#A5A5A5" TextColor="Black" FontSize="24" CornerRadius="50" />
            <Button Grid.Row="0" Grid.Column="1" Text="+/-" Clicked="ButtonToggleSign_Clicked" 
                    BackgroundColor="#A5A5A5" TextColor="Black" FontSize="24" CornerRadius="50" />
            <Button Grid.Row="0" Grid.Column="2" Text="÷" Clicked="ButtonOperators_Clicked" 
                    BackgroundColor="#FF9500" TextColor="White" FontSize="30" CornerRadius="50" />
            <Button Grid.Row="0" Grid.Column="3" Text="×" Clicked="ButtonOperators_Clicked" 
                    BackgroundColor="#FF9500" TextColor="White" FontSize="30" CornerRadius="50" />

            <!-- Ряд 2 -->
            <Button Grid.Row="1" Grid.Column="0" Text="7" Clicked="ButtonDigits_Clicked" 
                    BackgroundColor="#333333" TextColor="White" FontSize="30" CornerRadius="50" />
            <Button Grid.Row="1" Grid.Column="1" Text="8" Clicked="ButtonDigits_Clicked" 
                    BackgroundColor="#333333" TextColor="White" FontSize="30" CornerRadius="50" />
            <Button Grid.Row="1" Grid.Column="2" Text="9" Clicked="ButtonDigits_Clicked" 
                    BackgroundColor="#333333" TextColor="White" FontSize="30" CornerRadius="50" />
            <Button Grid.Row="1" Grid.Column="3" Text="-" Clicked="ButtonOperators_Clicked" 
                    BackgroundColor="#FF9500" TextColor="White" FontSize="30" CornerRadius="50" />

            <!-- Ряд 3 -->
            <Button Grid.Row="2" Grid.Column="0" Text="4" Clicked="ButtonDigits_Clicked" 
                    BackgroundColor="#333333" TextColor="White" FontSize="30" CornerRadius="50" />
            <Button Grid.Row="2" Grid.Column="1" Text="5" Clicked="ButtonDigits_Clicked" 
                    BackgroundColor="#333333" TextColor="White" FontSize="30" CornerRadius="50" />
            <Button Grid.Row="2" Grid.Column="2" Text="6" Clicked="ButtonDigits_Clicked" 
                    BackgroundColor="#333333" TextColor="White" FontSize="30" CornerRadius="50" />
            <Button Grid.Row="2" Grid.Column="3" Text="+" Clicked="ButtonOperators_Clicked" 
                    BackgroundColor="#FF9500" TextColor="White" FontSize="30" CornerRadius="50" />

            <!-- Ряд 4 -->
            <Button Grid.Row="3" Grid.Column="0" Text="1" Clicked="ButtonDigits_Clicked" 
                    BackgroundColor="#333333" TextColor="White" FontSize="30" CornerRadius="50" />
            <Button Grid.Row="3" Grid.Column="1" Text="2" Clicked="ButtonDigits_Clicked" 
                    BackgroundColor="#333333" TextColor="White" FontSize="30" CornerRadius="50" />
            <Button Grid.Row="3" Grid.Column="2" Text="3" Clicked="ButtonDigits_Clicked" 
                    BackgroundColor="#333333" TextColor="White" FontSize="30" CornerRadius="50" />
            <Button Grid.Row="3" Grid.Column="3" Grid.RowSpan="2" Text="=" Clicked="ButtonEqual_Clicked" ZIndex="1"
                    BackgroundColor="#FF9500" TextColor="White" FontSize="30" CornerRadius="50" />

            <!-- Ряд 5 -->
            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="0" Clicked="ButtonDigits_Clicked" 
                    BackgroundColor="#333333" TextColor="White" FontSize="30" CornerRadius="50" />
            <Button Grid.Row="4" Grid.Column="2" Text="." Clicked="ButtonDecimal_Clicked" 
                    BackgroundColor="#333333" TextColor="White" FontSize="30" CornerRadius="50" />
        </Grid>
    </Grid>
</ContentPage>